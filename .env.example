# Salin file ini menjadi .env lalu isi nilainya
#
# Mode aplikasi:
#   live (default) → login Google (Clerk) + onboarding, durasi maks 30m, time-gating ketat
#   demo           → one-click login dummy, demo clock, tombol Tambah/Hapus Dummy
VITE_APP_MODE=live

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_GEMINI_API_KEY=AIzaSy...
# Clerk (autentikasi Google) — ambil Publishable Key dari dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
