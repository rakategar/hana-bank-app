# Salin file ini menjadi .env lalu isi nilainya
#
# Mode aplikasi:
#   live (default) → login Google (Clerk) + onboarding, durasi maks 30m, time-gating ketat
#   demo           → one-click login dummy, demo clock, tombol Tambah/Hapus Dummy
VITE_APP_MODE=live

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# Clerk (autentikasi Google) — ambil Publishable Key dari dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── AI (Claude) ──────────────────────────────────────────────
# Penilaian & ringkasan AI memakai Claude via proxy serverless /api/ai.
# Key Anthropic disimpan SERVER-SIDE (TANPA prefix VITE_) agar tidak masuk bundle browser.
# Set di Vercel → Project Settings → Environment Variables:
ANTHROPIC_API_KEY=sk-ant-...
# Flag UI (non-rahasia): 'true' mengaktifkan fitur AI; 'false' menampilkan banner nonaktif.
VITE_AI_ENABLED=true
